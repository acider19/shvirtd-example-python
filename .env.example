# Значения для локального запуска.
# Используются в compose.yaml для локального контейнера MySQL.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=example
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app_password

# Значения для облачного запуска.
# Используются в compose.cloud.yaml на VM.
#
# APP_IMAGE:
#   Взять из Yandex Container Registry после docker push.
#   Формат: cr.yandex/<registry_id>/<image_name>:<tag>
APP_IMAGE=cr.yandex/<registry_id>/python_server:latest

# DB_HOST:
#   Взять из host/endpoint кластера Yandex Managed Service for MySQL.
DB_HOST=<mdb_host>

# DB_NAME:
#   Должно совпадать с именем БД, созданной Terraform в модуле database_mdb.
#   Если в имени есть дефисы, приложение уже умеет работать с ним через параметр подключения.
DB_NAME=<database_name>

# DB_USER:
#   Должно совпадать с пользователем БД, созданным Terraform в модуле database_mdb.
DB_USER=<database_user>

# DB_PASSWORD:
#   Взять из того же источника, который Terraform использует для пароля пользователя MDB.
#   Позже пароль должен браться из LockBox, а не храниться в git.
DB_PASSWORD=<database_password>
